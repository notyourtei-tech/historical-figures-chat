# ===== 默认：零外部费用、本地人物引擎 =====
# 默认 offline：用户消息不会被发送给任何模型服务；无需 API Key。
HISTORICAL_CHAT_MODE=offline

# ===== 可选：在线模型增强（必须显式改为 online；额度与价格可能变化）=====
# HISTORICAL_CHAT_MODE=online
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# ===== 可选：Upstash Redis（用于生产环境 Rate Limit）=====
# 注册 https://upstash.com 获取免费 Redis 实例
# UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url
# UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# ===== 可选：Supabase Auth + 云端会话 =====
# 不配置时，应用仍可使用“本机体验登录”：邮箱仅保存在这台设备，密码不保存也不上传。
# https://supabase.com/dashboard/project/_/settings/api
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key
# 仅服务器使用；绝不要放到 NEXT_PUBLIC_ 变量或客户端代码中
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ===== 可选：Sentry 错误监控 =====
# SENTRY_DSN=https://...@o0.ingest.sentry.io/0
# NEXT_PUBLIC_SENTRY_DSN=https://...@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=production

# 请将以上配置复制到 .env.local，修改后重启 npm run dev

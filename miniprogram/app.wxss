/* 万古灵犀 · 全局样式 */

page {
  --ink-50: #f8f5f0;
  --ink-100: #f0ece6;
  --ink-200: #e0dbd3;
  --ink-300: #b0a89e;
  --ink-400: #6b6258;
  --ink-500: #2c2416;
  --vermilion: #c0392b;
  --vermilion-hover: #a93226;
  --vermilion-light: rgba(192, 57, 43, 0.08);
  --border: #e0dbd3;
  --white: #ffffff;

  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC',
    'Hiragino Sans GB', 'Microsoft YaHei', 'Helvetica Neue', Helvetica, Arial,
    sans-serif;
  font-size: 14px;
  color: var(--ink-500);
  background-color: var(--ink-50);
  box-sizing: border-box;
}

/* 安全区域适配 */
.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* 通用卡片 */
.ink-card {
  background: var(--white);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* 朱红主题色 */
.vermilion-text {
  color: var(--vermilion);
}

.vermilion-bg {
  background-color: var(--vermilion);
}

/* 文字颜色 */
.ink-500 { color: var(--ink-500); }
.ink-400 { color: var(--ink-400); }
.ink-300 { color: var(--ink-300); }

/* 布局 */
.flex { display: flex; }
.flex-1 { flex: 1; }
.flex-col { flex-direction: column; }
.items-center { align-items: center; }
.justify-center { justify-content: center; }
.justify-between { justify-content: space-between; }
.text-center { text-align: center; }

/* 间距 */
.p-4 { padding: 32rpx; }
.p-3 { padding: 24rpx; }
.p-2 { padding: 16rpx; }
.mb-3 { margin-bottom: 24rpx; }
.mb-4 { margin-bottom: 32rpx; }
.mt-2 { margin-top: 16rpx; }
.mt-3 { margin-top: 24rpx; }
.mt-4 { margin-top: 32rpx; }
.gap-2 { gap: 16rpx; }
.gap-3 { gap: 24rpx; }

/* 圆角 */
.rounded-full { border-radius: 50%; }
.rounded-xl { border-radius: 24rpx; }
.rounded-lg { border-radius: 16rpx; }

/* 按钮 */
.btn-primary {
  background: var(--vermilion);
  color: var(--white);
  border: none;
  border-radius: 24rpx;
  padding: 24rpx 48rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
}

.btn-primary:active {
  background: var(--vermilion-hover);
}

.btn-secondary {
  background: var(--white);
  color: var(--ink-400);
  border: 1rpx solid var(--border);
  border-radius: 24rpx;
  padding: 24rpx 48rpx;
  font-size: 28rpx;
  text-align: center;
}

.btn-secondary:active {
  background: var(--ink-100);
}

/* 标签 */
.era-tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  background: var(--ink-100);
  color: var(--ink-400);
  font-size: 20rpx;
  border-radius: 8rpx;
}

/* 分割线 */
.vermilion-line {
  height: 2rpx;
  background: var(--vermilion);
  border-radius: 1rpx;
}

/* 隐藏滚动条 */
::-webkit-scrollbar {
  width: 0;
  height: 0;
}

/* 输入框基础样式 */
input, textarea {
  font-family: inherit;
  font-size: inherit;
  color: inherit;
}

/* 聊天页面 */

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--ink-50);
}

/* 顶部 */
.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  background: rgba(248, 245, 240, 0.95);
  backdrop-filter: blur(10px);
  border-bottom: 1rpx solid var(--border);
  position: sticky;
  top: 0;
  z-index: 100;
}

.top-bar-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.top-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 2rpx solid var(--vermilion);
}

.top-info {
  display: flex;
  flex-direction: column;
}

.top-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink-500);
}

.top-title {
  font-size: 22rpx;
  color: var(--ink-300);
}

.top-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 36rpx;
  color: var(--ink-400);
  background: var(--ink-100);
}

/* 菜单 */
.menu-dropdown {
  position: absolute;
  top: 104rpx;
  right: 24rpx;
  background: var(--white);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  z-index: 200;
}

.menu-item {
  padding: 24rpx 48rpx;
  font-size: 28rpx;
  color: var(--vermilion);
}

.overlay {
  position: fixed;
  inset: 0;
  background: transparent;
  z-index: 150;
}

/* 消息区域 */
.messages {
  flex: 1;
  overflow-y: auto;
}

.messages-inner {
  padding: 32rpx 16rpx;
  position: relative;
}

/* 加载指示器 */
.loading-indicator {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
}

.typing-dots {
  display: flex;
  gap: 8rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--ink-300);
  animation: blink 1.4s infinite both;
}

.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes blink {
  0%, 80%, 100% { opacity: 0.3; transform: scale(0.8); }
  40% { opacity: 1; transform: scale(1); }
}

.loading-text {
  font-size: 24rpx;
  color: var(--ink-300);
}

/* 滚动到底部 */
.scroll-bottom-btn {
  position: absolute;
  bottom: 16rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--white);
  border: 1rpx solid var(--border);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--ink-400);
  z-index: 10;
}

/* 输入栏 */
.input-bar {
  padding: 16rpx 24rpx;
  background: var(--white);
  border-top: 1rpx solid var(--border);
}

.input-inner {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  background: var(--ink-50);
  border-radius: 24rpx;
  padding: 12rpx 16rpx;
}

.chat-input {
  flex: 1;
  min-height: 40rpx;
  max-height: 200rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--ink-500);
  padding: 8rpx 0;
}

.chat-input::placeholder {
  color: var(--ink-300);
}

.send-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--ink-200);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: var(--ink-300);
  flex-shrink: 0;
}

.send-btn.active {
  background: var(--vermilion);
  color: var(--white);
}

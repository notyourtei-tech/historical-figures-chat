/* 主页样式 */

.page {
  min-height: 100vh;
  background: var(--ink-50);
  padding-bottom: env(safe-area-inset-bottom);
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: calc(24rpx + env(safe-area-inset-top)) 32rpx 24rpx;
  background: rgba(248, 245, 240, 0.95);
  backdrop-filter: blur(10px);
  position: sticky;
  top: 0;
  z-index: 100;
  border-bottom: 1rpx solid var(--border);
}

.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--ink-500);
}

.header-lang {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: var(--ink-100);
  border-radius: 16rpx;
  font-size: 24rpx;
  color: var(--ink-400);
  min-height: 64rpx;
  box-sizing: border-box;
}

.header-lang:active {
  background: var(--ink-200);
}

.lang-dropdown {
  position: absolute;
  top: 96rpx;
  right: 32rpx;
  background: var(--white);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  z-index: 200;
  overflow: hidden;
}

.lang-item {
  padding: 24rpx 40rpx;
  font-size: 26rpx;
  color: var(--ink-400);
  border-bottom: 1rpx solid var(--border);
}

.lang-item:last-child {
  border-bottom: none;
}

.lang-item.active {
  color: var(--vermilion);
  font-weight: 700;
  background: var(--vermilion-light);
}

.overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.1);
  z-index: 150;
}

/* Hero */
.hero {
  margin: 32rpx;
  padding: 64rpx 48rpx;
  background: linear-gradient(135deg, rgba(192, 57, 43, 0.11), rgba(255, 255, 255, 0.94) 58%, rgba(192, 57, 43, 0.04));
  border: 1rpx solid rgba(192, 57, 43, 0.1);
  border-radius: 32rpx;
  text-align: center;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ink-500);
  display: block;
  margin-bottom: 16rpx;
}

.hero-subtitle {
  font-size: 26rpx;
  color: var(--ink-400);
  display: block;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.hero-stats {
  font-size: 22rpx;
  color: var(--ink-300);
  display: block;
}

/* 搜索 */
.search-bar {
  margin: 0 32rpx 24rpx;
}

.search-input {
  width: 100%;
  padding: 24rpx 32rpx;
  background: var(--white);
  border: 1rpx solid var(--border);
  border-radius: 24rpx;
  font-size: 28rpx;
  color: var(--ink-500);
  box-sizing: border-box;
  min-height: 88rpx;
}

.search-input:focus {
  border-color: var(--vermilion);
  box-shadow: 0 0 0 4rpx rgba(192, 57, 43, 0.12);
}

.search-input::placeholder {
  color: var(--ink-300);
}

/* 分类 */
.category-scroll {
  margin: 0 0 24rpx;
  white-space: nowrap;
}

.category-list {
  display: flex;
  gap: 16rpx;
  padding: 0 32rpx;
}

.category-item {
  display: inline-flex;
  padding: 16rpx 32rpx;
  background: var(--white);
  border: 1rpx solid var(--border);
  border-radius: 20rpx;
  font-size: 24rpx;
  color: var(--ink-400);
  flex-shrink: 0;
}

.category-item.active {
  background: var(--vermilion);
  color: var(--white);
  border-color: var(--vermilion);
}

.category-item:active {
  transform: scale(0.97);
}

/* 人物网格 */
.celebrities-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  padding: 0 32rpx 48rpx;
}

.celebrities-grid > * {
  width: calc(50% - 12rpx);
}

/* 空状态 */
.empty {
  display: flex;
  justify-content: center;
  padding: 128rpx 0;
}

.empty-text {
  color: var(--ink-300);
  font-size: 28rpx;
}

/* 历史记录 */
.history-section {
  margin: 0 32rpx 48rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink-400);
  margin-bottom: 16rpx;
}

.history-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 24rpx;
  background: var(--white);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.history-item:active {
  background: var(--ink-100);
}

.history-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink-500);
}

.history-msg {
  font-size: 24rpx;
  color: var(--ink-300);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

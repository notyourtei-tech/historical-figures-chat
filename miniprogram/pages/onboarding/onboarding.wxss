.page {
  min-height: 100vh;
  background: var(--ink-50);
  display: flex;
  flex-direction: column;
  padding: 32rpx;
}

.step {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.step-header {
  text-align: center;
  margin-bottom: 64rpx;
  margin-top: 80rpx;
}

.step-icon {
  font-size: 64rpx;
  display: block;
  margin-bottom: 24rpx;
}

.step-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--ink-500);
  display: block;
  margin-bottom: 16rpx;
}

.step-sub {
  font-size: 26rpx;
  color: var(--ink-400);
  display: block;
}

/* 语言列表 */
.lang-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 48rpx;
}

.lang-option {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  background: var(--white);
  border: 1rpx solid var(--border);
  border-radius: 20rpx;
  font-size: 28rpx;
  color: var(--ink-400);
}

.lang-option.active {
  border-color: var(--vermilion);
  color: var(--vermilion);
  font-weight: 600;
  background: var(--vermilion-light);
}

/* 兴趣网格 */
.interest-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 48rpx;
}

.interest-item {
  padding: 24rpx 40rpx;
  background: var(--white);
  border: 1rpx solid var(--border);
  border-radius: 20rpx;
  font-size: 26rpx;
  color: var(--ink-400);
}

.interest-item.active {
  border-color: var(--vermilion);
  color: var(--vermilion);
  font-weight: 600;
  background: var(--vermilion-light);
}

/* 姓名输入 */
.name-input {
  width: 100%;
  padding: 32rpx;
  background: var(--white);
  border: 1rpx solid var(--border);
  border-radius: 20rpx;
  font-size: 28rpx;
  color: var(--ink-500);
  margin-bottom: 48rpx;
  box-sizing: border-box;
}

.name-input::placeholder {
  color: var(--ink-300);
}

/* 底部按钮 */
.step-footer {
  display: flex;
  gap: 24rpx;
  margin-top: auto;
  padding-bottom: 48rpx;
}

.btn-primary {
  flex: 2;
  padding: 28rpx;
  background: var(--vermilion);
  color: var(--white);
  border: none;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
}

.btn-primary:active {
  background: var(--vermilion-hover);
}

.btn-secondary {
  flex: 1;
  padding: 28rpx;
  background: var(--white);
  color: var(--ink-400);
  border: 1rpx solid var(--border);
  border-radius: 24rpx;
  font-size: 28rpx;
  text-align: center;
}

.btn-secondary:active {
  background: var(--ink-100);
}

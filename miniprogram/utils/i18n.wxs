function replace(str, vars) {
  if (!vars) return str;
  var result = str;
  for (var k in vars) {
    result = result.replace('{' + k + '}', '' + vars[k]);
  }
  return result;
}

module.exports = {
  t: function (lang, key, vars) {
    var dict = translations[lang];
    if (!dict) dict = translations.zh;
    var text = dict[key];
    if (!text) text = key;
    return replace(text, vars);
  },
};
